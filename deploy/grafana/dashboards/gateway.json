          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(gateway_requests_total, upstream)",
          "refId": "upstream"
        },
        "definition": "label_values(gateway_requests_total, upstream)",
        "refresh": 2,
        "includeAll": true,
