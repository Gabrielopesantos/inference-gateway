    {
      "type": "table",
      "title": "Cost by caller",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "gateway-sqlite"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "cost_usd"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 4
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "gateway-sqlite"
          },
          "queryType": "table",
          "rawQueryText": "SELECT coalesce(t.caller_id, '(no caller id)') AS caller,\n       count(*) AS requests,\n       sum(t.input_tokens_total) AS input_tokens,\n       sum(t.output_tokens) AS output_tokens,\n       sum(t.cost_usd) AS cost_usd\nFROM traces t\nWHERE t.started_at >= $__from AND t.started_at < $__to AND ('${upstream:csv}' = '.*' OR ',${upstream:csv},' LIKE '%,' || t.upstream || ',%') AND ('${model:csv}' = '.*' OR ',${model:csv},' LIKE '%,' || coalesce(t.response_model, t.requested_model) || ',%')\nGROUP BY 1\nORDER BY cost_usd DESC",
          "queryText": "SELECT coalesce(t.caller_id, '(no caller id)') AS caller,\n       count(*) AS requests,\n       sum(t.input_tokens_total) AS input_tokens,\n       sum(t.output_tokens) AS output_tokens,\n       sum(t.cost_usd) AS cost_usd\nFROM traces t\nWHERE t.started_at >= $__from AND t.started_at < $__to AND ('${upstream:csv}' = '.*' OR ',${upstream:csv},' LIKE '%,' || t.upstream || ',%') AND ('${model:csv}' = '.*' OR ',${model:csv},' LIKE '%,' || coalesce(t.response_model, t.requested_model) || ',%')\nGROUP BY 1\nORDER BY cost_usd DESC",
          "timeColumns": [
            "time"
          ]
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": "From the SQLite store. caller = HMAC of the API key; set IG_IDENTITY_SECRET to fill it.",
      "gridPos": {
        "x": 12,
        "y": 23,
        "w": 12,
        "h": 8
      },
