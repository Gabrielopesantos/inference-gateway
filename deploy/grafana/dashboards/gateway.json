          "rawQueryText": "SELECT t.started_at / 1000.0 AS time,\n       t.upstream,\n       coalesce(t.response_model, t.requested_model) AS model,\n       t.outcome,\n       t.stop_reason,\n       t.ttft_ms,\n       t.duration_ms,\n       t.input_tokens_total AS input,\n       t.output_tokens AS output,\n       t.cost_usd,\n       t.session_id AS session,\n       t.captured,\n       lower(hex(coalesce(t.otel_trace_id, t.id))) AS trace\nFROM traces t\nWHERE t.started_at >= $__from AND t.started_at < $__to AND ('${upstream:csv}' = '.*' OR ',${upstream:csv},' LIKE '%,' || t.upstream || ',%') AND ('${model:csv}' = '.*' OR ',${model:csv},' LIKE '%,' || coalesce(t.response_model, t.requested_model) || ',%')\nORDER BY t.started_at DESC\nLIMIT 100",
